{"id": "ST-AUDIT-014", "name": "row split parity", "models": ["bonsai"], "timeout_ms": 1800000}
{"do": "host.start"}
{"do": "parallel", "steps": [{"do": "join", "actor": "one", "kind": "native"}, {"do": "join", "actor": "two", "kind": "native"}, {"do": "join", "actor": "three", "kind": "native"}, {"do": "join", "actor": "four", "kind": "native"}]}
{"do": "generate", "id": "reference", "request": {"local_only": true, "connector_count": 0}, "expect": [{"field": "kind", "equals": "done"}, {"field": "text", "equals": ","}]}
{"do": "generate", "id": "distributed", "request": {"split_axis": "rows"}, "expect": [{"field": "kind", "equals": "done"}, {"field": "remote_shards", "gt": 0}, {"field": "text", "equals": ","}]}
{"do": "assert.tokens", "left": "reference", "right": "distributed"}
{"do": "assert.participation", "minimum": 4}
