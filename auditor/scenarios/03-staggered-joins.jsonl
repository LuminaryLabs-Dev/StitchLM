{"id": "ST-AUDIT-003", "name": "staggered joins", "models": ["lfm"], "timeout_ms": 300000}
{"do": "host.start"}
{"do": "join", "actor": "one", "kind": "native"}
{"do": "delay", "ms": 150}
{"do": "join", "actor": "two", "kind": "browser"}
{"do": "wait.ready", "count": 2}
{"do": "generate", "id": "answer", "expect": [{"field": "kind", "equals": "done"}, {"field": "remote_blocks", "gt": 0}, {"field": "text", "equals": "hello"}]}
